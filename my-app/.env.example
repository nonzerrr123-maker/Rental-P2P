# PostgreSQL development connection.
# Override these in .env.local / deployment secrets and never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p_rental
DATABASE_POOL_MAX=10

# Bootstrap superadmin credentials. The account is persisted into PostgreSQL and
# uses the same database-backed session flow as other accounts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Public application URL used in auth email links. Pin this in production so email
# links do not depend on the incoming request host. Vercel's production URL is used
# automatically when available.
APP_BASE_URL=http://localhost:3000

# Resend transactional email. `onboarding@resend.dev` is suitable only for testing
# to the Resend account owner's email. Verify a domain before sending to real users.
RESEND_API_BASE_URL=https://api.resend.com
RESEND_API_KEY=
EMAIL_FROM=Borow Borow <onboarding@resend.dev>
RESEND_REQUEST_TIMEOUT_MS=8000

# Keep enforcement off until a sending domain is verified and email delivery is
# production-ready. Verify/reset flows still work while this is false.
EMAIL_REQUIRE_VERIFICATION=false
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60

# KYC provider mode.
# Keep `manual` until Persona Sandbox credentials and a Thailand-capable Inquiry
# Template have been validated. In manual mode, ADMIN/SUPERADMIN review requests.
KYC_PROVIDER=manual

# Persona Hosted Flow integration. Never commit real values.
# When KYC_PROVIDER=persona, all three credentials below are required; otherwise
# the app automatically falls back to Manual Admin Review so KYC cannot block MVP.
PERSONA_API_BASE_URL=https://api.withpersona.com
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Optional: pin the Persona API version after validating the chosen Sandbox template.
PERSONA_API_VERSION=

# Bound outbound provider calls so an unresponsive KYC vendor cannot block MVP.
# A failed/timed-out inquiry start automatically falls back to Manual Admin Review.
PERSONA_REQUEST_TIMEOUT_MS=8000

# Reject signed Persona webhooks whose timestamp differs from server time by more than this.
PERSONA_WEBHOOK_TOLERANCE_SECONDS=300

# Urgent borrow reservation hold. This is application/database logic only and does
# not require an external API. Range: 1-120 minutes; default is 15 when omitted.
URGENT_RESERVATION_TTL_MINUTES=15

# Payment provider. Keep sandbox as the safe default. Set `omise` only after test
# credentials and PromptPay availability have been validated on the merchant account.
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_ENABLED=false

# Omise / Opn Thailand PromptPay integration. Secret values are server-only.
# OMISE_SECRET_KEY is the provider credential required by the application. Omise
# webhooks are authenticated by independently retrieving the referenced charge with
# this key before mutating payment state, as recommended by the provider docs.
OMISE_API_BASE_URL=https://api.omise.co
OMISE_SECRET_KEY=
OMISE_REQUEST_TIMEOUT_MS=8000

# Optional defense-in-depth for a trusted signing proxy/custom webhook signer.
# Do not invent a value just to use Omise's standard webhook endpoint; leave blank
# unless your deployment actually supplies matching HMAC headers.
OMISE_WEBHOOK_SECRET=
OMISE_WEBHOOK_TOLERANCE_SECONDS=300

# Bank payout/transfer is deliberately disabled by default. Enable only after the
# Omise merchant account and intended recipients are verified and operational rules
# for releasing lender funds have been approved. Never use this switch to bypass
# recipient verification.
OMISE_ENABLE_LIVE_PAYOUTS=false

# S3-compatible object storage for rental listing images and user avatars.
# Cloudflare R2 example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# The same adapter can be used with AWS S3 or MinIO by changing the endpoint/region.
# Never commit real access keys.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=

# R2/MinIO work well with path-style bucket addressing through the configured endpoint.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=15000
