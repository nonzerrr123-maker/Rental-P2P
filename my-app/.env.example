# PostgreSQL development connection.
# Override these in .env.local / deployment secrets and never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p_rental
DATABASE_POOL_MAX=10

# Bootstrap superadmin credentials. The account is persisted into PostgreSQL and
# uses the same database-backed session flow as other accounts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# KYC provider mode.
# Keep `manual` until Persona Sandbox credentials and a Thailand-capable Inquiry
# Template have been validated. In manual mode, ADMIN/SUPERADMIN review requests.
KYC_PROVIDER=manual

# Persona Hosted Flow integration. Never commit real values.
# When KYC_PROVIDER=persona, all three credentials below are required; otherwise
# the app automatically falls back to Manual Admin Review so KYC cannot block MVP.
PERSONA_API_BASE_URL=https://api.withpersona.com
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Optional: pin the Persona API version after validating the chosen Sandbox template.
PERSONA_API_VERSION=

# Bound outbound provider calls so an unresponsive KYC vendor cannot block MVP.
# A failed/timed-out inquiry start automatically falls back to Manual Admin Review.
PERSONA_REQUEST_TIMEOUT_MS=8000

# Reject signed webhooks whose timestamp differs from server time by more than this.
PERSONA_WEBHOOK_TOLERANCE_SECONDS=300
