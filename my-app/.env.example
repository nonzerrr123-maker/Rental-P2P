# PostgreSQL development connection.
# Override this in .env.local / deployment secrets and never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p_rental

# Bootstrap superadmin credentials for the current prototype auth route.
# TASK 3 / the auth phase will migrate normal account authentication to PostgreSQL-backed sessions.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
