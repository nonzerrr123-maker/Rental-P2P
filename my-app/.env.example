# PostgreSQL development connection.
# Override these in .env.local / deployment secrets and never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p_rental
DATABASE_POOL_MAX=10

# Bootstrap superadmin credentials for the current prototype auth route.
# The Authentication phase will migrate normal account authentication to PostgreSQL-backed sessions.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
